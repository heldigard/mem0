{
    "mem0": {
        "llm": {
            "provider": "openai",
            "config": {
                "model": "gpt-5-mini-2025-08-07",
                "temperature": 1.0,
                "max_tokens": 2000,
                "api_key": "env:OPENAI_API_KEY"
            }
        },
        "embedder": {
            "provider": "ollama",
            "config": {
                "model": "qwen3-embedding:4b",
                "ollama_base_url": "http://host.docker.internal:11434"
            }
        }
    }
}
