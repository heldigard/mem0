{
    "mem0": {
        "llm": {
            "provider": "deepseek",
            "config": {
                "model": "deepseek-chat",
                "temperature": 0.1,
                "max_tokens": 2000,
                "api_key": "env:DEEPSEEK_API_KEY"
            }
        },
        "embedder": {
            "provider": "ollama",
            "config": {
                "model": "qwen3-embedding:4b",
                "ollama_base_url": "http://host.docker.internal:11434"
            }
        }
    }
}
